# Syrové obrázky budov: velké a znovu vygenerovatelné z promptů.
# Do repa jde až to, co z nich udělá tools/fit-sprites.py.
art/sprites/raw/*.png

# Syrové obrázky dlaždic: totéž co u budov — velké a znovu vygenerovatelné.
art/tiles/raw/*.png
art/tiles/rejected/*.png

# Syrové díly pro animace (docs/18-DILY.md): totéž co u budov.
art/parts/raw/*.png

# Bajtkód Pythonu. Do repa se dostal omylem s nástroji na sprity.
__pycache__/
*.pyc
tools/.build/

# Výstup simulace: statisíce řádků měření, do repa nepatří.
data/
# Kopie buildu se vlozenou CSP, kterou se hlavicky zkousi pred nasazenim.
dist-csp/
# Přeložené nástroje. `tools/.build/` je ta obvyklá; `tools/.b-*` vzniká, když
# běží A/B dvou verzí zároveň — `vite build` maže celý outDir, takže se dvě
# varianty nedají přeložit do jednoho.
tools/.build/
tools/.b-*/
art/parts/chimneys/
art/sprites/archive/sejdrem/
art/sprites/archive/strme/
